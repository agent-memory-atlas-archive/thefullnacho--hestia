# Copy to secrets.yaml (gitignored) and fill in. ESPHome reads it from this directory.
# The board is 2.4 GHz only.
wifi_ssid: "your 2.4 GHz network"
wifi_password: "its password"

# openssl rand -base64 32
kennel_api_key: ""  # also encrypts over-the-air updates

# The whelping-box H5075, as shown by: bluetoothctl --timeout 20 scan on | grep GVH5075
govee_box_mac: "A4:C1:38:00:00:00"
