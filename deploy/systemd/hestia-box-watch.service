[Unit]
Description=Hestia — box watch (whelping-box temperature vs the litter's week -> phone alert)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/hestia/brain
ExecStart=%h/.local/bin/uv run --project %h/hestia/brain python %h/hestia/brain/box_watch.py
